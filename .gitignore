# ==========================================
# 1. DEPENDENCIES & PACKAGE MANAGERS
# ==========================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# 2. NEXT.JS BUILD & EXPORT OUTPUTS (PENTING!)
# ==========================================
/.next/
/out/
/build/
/dist/

# ==========================================
# 3. ENVIRONMENT & SECRETS (KEAMANAN)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# ==========================================
# 4. LOGS & DEBUG FILES
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/coverage

# ==========================================
# 5. CACHE, SYSTEM & IDE FILES
# ==========================================
.DS_Store
Thumbs.db
*.tsbuildinfo
next-env.d.ts
.vercel
.eslintcache
.vscode/*
!.vscode/settings.json